LOCAL_DOMAIN=${MASTODON_DOMAIN}
WEB_DOMAIN=${MASTODON_DOMAIN}
RAILS_ENV=production
NODE_ENV=production
DB_HOST=mastodon-db
DB_PORT=5432
DB_NAME=${MASTODON_DB_DATABASE}
DB_USER=${MASTODON_DB_USER}
DB_PASS=${MASTODON_DB_PASSWORD}
REDIS_HOST=redis
REDIS_PORT=6379
SECRET_KEY_BASE=${SECRET_KEY_BASE}
OTP_SECRET=${OTP_SECRET}
VAPID_PRIVATE_KEY=${VAPID_PRIVATE_KEY}
VAPID_PUBLIC_KEY=${VAPID_PUBLIC_KEY}
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=${ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY}
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=${ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT}
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=${ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY}
# Allow Mastodon to fetch/deliver to the XWiki instance across the private Docker network.
# In production Mastodon's SSRF guard (app/lib/request.rb) raises PrivateNetworkAddressError for
# any private-range target unless it is whitelisted here. xwiki.local resolves to the Caddy proxy
# on this pinned subnet, so without this, resolving/following @user@xwiki.local from Mastodon fails.
ALLOWED_PRIVATE_ADDRESSES=10.89.0.0/24
