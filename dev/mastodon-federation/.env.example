# ── Image tags (Renovate-pinnable) ───────────────────────────────
XWIKI_IMAGE=xwiki:lts-postgres-tomcat
MASTODON_IMAGE=ghcr.io/mastodon/mastodon:v4.6.3
MASTODON_STREAMING_IMAGE=ghcr.io/mastodon/mastodon-streaming:v4.6.3
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
CADDY_IMAGE=caddy:2-alpine

# ── Domains (must match /etc/hosts) ──────────────────────────────
XWIKI_DOMAIN=xwiki.local
MASTODON_DOMAIN=mastodon.local

# ── Host ports published by Caddy ────────────────────────────────
# Defaults 443/80 are the clean choice: Mastodon actor URLs and browser
# links omit the port, so federation "just works". Override only if those
# ports are taken on your host (e.g. HTTPS_PORT=8443 HTTP_PORT=8080) — then
# browse https://xwiki.local:${HTTPS_PORT}/ and note the caveats in the root README.
HTTPS_PORT=443
HTTP_PORT=80

# ── XWiki DB ─────────────────────────────────────────────────────
XWIKI_DB_USER=xwiki
XWIKI_DB_PASSWORD=xwiki
XWIKI_DB_DATABASE=xwiki

# ── XWiki accounts ───────────────────────────────────────────────
XWIKI_ADMIN_USER=superadmin
XWIKI_ADMIN_PASSWORD=admin
XWIKI_TEST_USER=xtest
XWIKI_TEST_PASSWORD=xtest12345

# ── Mastodon DB ──────────────────────────────────────────────────
MASTODON_DB_USER=mastodon
MASTODON_DB_PASSWORD=mastodon
MASTODON_DB_DATABASE=mastodon_production

# ── Mastodon accounts (passwords generated by tootctl at provision)
MASTODON_OWNER_USER=mowner
MASTODON_TEST_USER=mtest

# ── Mastodon secrets (generated by scripts/up.sh on first run) ───
SECRET_KEY_BASE=
OTP_SECRET=
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
