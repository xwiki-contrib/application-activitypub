{
  // The settings the xwiki-contrib repositories share. See https://github.com/xwiki-contrib/.github
  "extends": ["github>xwiki-contrib/.github//renovate/default.json5"],

  // Track the GoToSocial container tag used by the federation integration test (webfinger-server pom), so a new
  // partner release opens a PR that re-runs the test and surfaces interoperability drift.
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["(^|/)pom\\.xml$"],
      "matchStrings": ["<gotosocial\\.image>(?<depName>[^:<]+):(?<currentValue>[^<]+)</gotosocial\\.image>"],
      "datasourceTemplate": "docker"
    }
  ]
}
